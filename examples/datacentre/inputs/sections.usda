#usda 1.0
(
    customLayerData = {
        string description = "Homogeneous sections from exported Qto wall Width. Material composition is unspecified; widths are measured source values."
    }
)

over "demo_datacentre_01"
{
    over "_TypeCatalog"
    {
        over "External_Wall_300" (
            prepend apiSchemas = ["AecoBuildUpAPI"]
        )
        {
            token[] aeco:buildUp:functions = ["other"]
            string[] aeco:buildUp:materials = ["unspecified"]
            int[] aeco:buildUp:priorities = [0]
            double[] aeco:buildUp:thicknesses = [0.3]
        }

        over "Internal_Wall_150" (
            prepend apiSchemas = ["AecoBuildUpAPI"]
        )
        {
            token[] aeco:buildUp:functions = ["other"]
            string[] aeco:buildUp:materials = ["unspecified"]
            int[] aeco:buildUp:priorities = [0]
            double[] aeco:buildUp:thicknesses = [0.15]
        }
    }
}

