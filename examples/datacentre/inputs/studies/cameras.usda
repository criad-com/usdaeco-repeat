#usda 1.0

def "Renders"
{
    def Camera "l01"
    {
        float2 clippingRange = (0.01, 2.9)
        float horizontalAperture = 230
        token projection = "orthographic"
        float verticalAperture = 143.75
        double3 xformOp:translate = (21, -6, 6.5)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Camera "l02"
    {
        float2 clippingRange = (0.01, 2.9)
        float horizontalAperture = 230
        token projection = "orthographic"
        float verticalAperture = 143.75
        double3 xformOp:translate = (21, -6, 9.5)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}

