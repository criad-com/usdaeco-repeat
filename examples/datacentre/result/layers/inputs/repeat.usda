#usda 1.0
(
    customLayerData = {
        string description = "L02 repeats L01; no deviations have been declared."
    }
)

over "demo_datacentre_01"
{
    over "demo_datacentre_01_Site"
    {
        over "demo_datacentre_01"
        {
            over "L02_Office" (
                prepend apiSchemas = ["AecoRepeatAPI"]
            )
            {
                rel aeco:repeat:prototype = </demo_datacentre_01/demo_datacentre_01_Site/demo_datacentre_01/L01_Office>
            }
        }
    }
}

